# Runtime environment: development locally; production on the hosted server.
NODE_ENV=development
# Backend HTTP port.
PORT=5000
# Exact browser origin allowed by the API CORS policy.
CLIENT_URL=http://localhost:3000
# PostgreSQL URLs; use the DB_PASSWORD value below, URL-encoded if it contains special characters.
DATABASE_URL=postgresql://victoria_fish:change-this-password@localhost:5432/victoria_fish
# Integration tests use the isolated test database created by the local PostgreSQL container.
TEST_DATABASE_URL=postgresql://victoria_fish:change-this-password@localhost:5432/victoria_fish_test
# Database user/password used by docker-compose.yml.
DB_USER=victoria_fish
DB_PASSWORD=change-this-password
# Database names used by docker-compose.yml and its initial test-database setup.
DB_NAME=victoria_fish
TEST_DB_NAME=victoria_fish_test
# PostgreSQL port exposed on this computer.
DB_PORT=5432
# Required session-signing and OTP-HMAC key; generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))".
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Required admin API key; use a different random value of at least 32 characters.
ADMIN_DASHBOARD_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
# One-time passcodes expire after 5-10 minutes.
OTP_EXPIRY_MINUTES=5
# Select exactly one OTP delivery provider: africastalking, email, or console (console only outside production).
OTP_PROVIDER=africastalking
# Africa's Talking only: API key from the account dashboard.
SMS_API_KEY=
# Africa's Talking only: account username (not the API key).
SMS_USERNAME=
# Africa's Talking only: optional approved sender ID; omitted from the request when blank.
SMS_SENDER_ID=
# Email provider only: Resend API key from https://resend.com/api-keys.
RESEND_API_KEY=
# Email provider only: sender address verified in Resend, e.g. "Victoria Fresh Fish <auth@example.com>".
OTP_EMAIL_FROM=
# Payment mode: mock is development-only; production requires Daraja.
MPESA_MODE=mock
# Daraja API root; use sandbox for development and production URL for live payments.
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
# Legacy alias for MPESA_BASE_URL; do not set both.
MPESA_API_URL=
# Daraja consumer key from Safaricom Daraja.
MPESA_CONSUMER_KEY=
# Daraja consumer secret from Safaricom Daraja.
MPESA_CONSUMER_SECRET=
# Daraja business shortcode; MPESA_BUSINESS_SHORTCODE is a legacy alias.
MPESA_SHORTCODE=
# Legacy shortcode alias; do not set both shortcode variables.
MPESA_BUSINESS_SHORTCODE=
# Daraja Lipa Na M-Pesa passkey.
MPESA_PASSKEY=
# Long random webhook query-secret; required in production.
MPESA_CALLBACK_SECRET=
# Public HTTPS callback URL required in production; development defaults to localhost.
MPESA_CALLBACK_URL=http://localhost:5000/api/orders/mpesa/callback
# Legacy callback URL aliases; do not set unless migrating existing configuration.
MPESA_PAYMENT_CALLBACK_URL=
MPESA_LOCAL_CALLBACK_URL=
# Daraja STK transaction type.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Optional Google OAuth client ID; Google sign-in is not currently implemented.
GOOGLE_CLIENT_ID=
# Optional Fuliza API key; Fuliza is not currently implemented.
FULIZA_API_KEY=
# Optional Fuliza client ID; Fuliza is not currently implemented.
FULIZA_CLIENT_ID=
# Optional Fuliza API base URL; Fuliza is not currently implemented.
FULIZA_BASE_URL=
