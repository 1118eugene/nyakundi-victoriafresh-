NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.example
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/victoria-fresh-fish
DB_NAME=victoria-fresh-fish
DEFAULT_LIMIT=10
MAX_LIMIT=100
ADMIN_DASHBOARD_KEY=generate-a-long-random-admin-key
MPESA_BASE_URL=https://api.safaricom.co.ke
MPESA_API_URL=https://api.safaricom.co.ke
MPESA_CONSUMER_KEY=your-production-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-production-daraja-consumer-secret
MPESA_SHORTCODE=your-production-business-shortcode
MPESA_BUSINESS_SHORTCODE=your-production-business-shortcode
MPESA_PASSKEY=your-production-daraja-passkey
# A long random secret appended to the callback URL for webhook protection.
MPESA_CALLBACK_SECRET=generate-a-long-random-callback-secret
# This must be a publicly reachable HTTPS URL. Localhost cannot receive Daraja callbacks.
MPESA_CALLBACK_URL=https://your-public-domain.com/api/orders/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
