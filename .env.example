# Frontend API base URL. Deployed builds need the public backend API URL.
VITE_API_URL=http://localhost:5000/api
# Public business contacts from the site's support endpoint; override only when the owner changes them.
VITE_WHATSAPP_NUMBER=254117224696
VITE_SUPPORT_PHONE=254117224696
VITE_SUPPORT_EMAIL=info@victoriafreshfish.ke
# Backward-compatible alias for VITE_API_URL; leave blank when using the preferred variable.
VITE_API_BASE_URL=
# Port used by the root production preview helper (defaults to 4173).
PORT=4173
