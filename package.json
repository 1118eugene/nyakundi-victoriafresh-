{
  "name": "victoria-fresh-fish-kenya",
  "version": "1.0.0",
  "description": "Victoria Fresh Fish Kenya - E-commerce & Business Website",
  "type": "module",
  "scripts": {
    "predev": "npm run db:up",
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:full": "npm run dev",
    "db:up": "docker compose --env-file backend/.env up -d --wait db",
    "db:setup": "npm --prefix backend run db:setup",
    "catalogue:import": "npm --prefix backend run catalogue:import",
    "catalogue:seed": "npm --prefix backend run catalogue:seed",
    "catalogue:seed:prod": "npm --prefix backend run catalogue:seed:prod",
    "test:backend": "npm --prefix backend test",
    "build": "tsc && vite build",
    "test:cart": "node --test src/contexts/cartUtils.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "start": "node scripts/start.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
